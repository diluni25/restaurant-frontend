NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

DATABASE_URL="mysql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:DB_PORT/tastoria_db?sslcert=ca.pem&sslaccept=strict"

# Required for JWT-protected admin routes. Generate random secret of at least 32 chars.
JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
