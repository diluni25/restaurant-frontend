{
  "name": "tastoria-restaurant-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tastoria backend foundation (Yuwantha setup)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/config/prisma.js && node --check src/config/env.js && node --check src/routes/health.routes.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "prisma": "^6.16.3"
  },
  "engines": {"node": ">=20.19.0"}
}
