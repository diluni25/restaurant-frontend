{
  "name": "tastoria-restaurant-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tastoria backend foundation (Yuwantha setup)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "check": "node -e \"const fs=require('fs');const cp=require('child_process');function walk(p){for(const f of fs.readdirSync(p,{withFileTypes:true})){const x=p+'/'+f.name;if(f.isDirectory())walk(x);else if(x.endsWith('.js'))cp.execFileSync(process.execPath,['--check',x],{stdio:'inherit'});}}walk('src');\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "prisma": "^6.16.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
