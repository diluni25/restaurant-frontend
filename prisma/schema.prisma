generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InquiryTopic {
  RESERVATION
  PRIVATE_DINING
  CELEBRATION
  DIETARY
  OTHER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  ARCHIVED
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]

  @@index([isActive, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(160)
  slug        String        @unique @db.VarChar(180)
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  imageUrl    String?       @db.VarChar(2048)
  isAvailable Boolean       @default(true)
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)
  categoryId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@index([categoryId, isAvailable, sortOrder])
  @@map("menu_items")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @db.VarChar(32)
  customerName  String      @db.VarChar(120)
  customerEmail String?     @db.VarChar(254)
  customerPhone String?     @db.VarChar(32)
  type          OrderType   @default(DINE_IN)
  status        OrderStatus @default(PENDING)
  tableName     String?     @db.VarChar(80)
  notes         String?     @db.Text
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  tax           Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @default(0) @db.Decimal(10, 2)
  currency      String      @default("USD") @db.Char(3)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  menuItemId   String?
  itemName     String    @db.VarChar(160)
  quantity     Int
  unitPrice    Decimal   @db.Decimal(10, 2)
  lineTotal    Decimal   @db.Decimal(10, 2)
  specialNotes String?   @db.VarChar(500)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Reservation {
  id          String            @id @default(cuid())
  guestName   String            @db.VarChar(120)
  email       String            @db.VarChar(254)
  phone       String?           @db.VarChar(32)
  partySize   Int
  requestedAt DateTime
  tableName   String?           @db.VarChar(80)
  status      ReservationStatus @default(PENDING)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([requestedAt, status])
  @@index([email, createdAt])
  @@map("reservations")
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(120)
  email       String        @db.VarChar(254)
  phone       String?       @db.VarChar(32)
  topic       InquiryTopic  @default(OTHER)
  preferredAt DateTime?
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  reply       String?       @db.Text
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([topic, createdAt])
  @@index([email, createdAt])
  @@map("inquiries")
}
